# ── Base de datos: Supabase (PostgreSQL) ──
# Dashboard de Supabase > Project Settings > Database > Connection string > URI
# Copia la URI y reemplaza [YOUR-PASSWORD] por la contraseña de tu proyecto.
# Usa el puerto 6543 (Transaction Pooler): es el recomendado para apps como esta.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Alternativa: Postgres local (si NO defines DATABASE_URL se usan estas)
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=barberia_db
# DB_PORT=5432

PORT=3000

# Cambia esto por una cadena larga y aleatoria en producción
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-en-produccion

# ── Pagos ──
# "simulado" (desarrollo/pruebas) o "wompi" (real).
PAGOS_PROVEEDOR=simulado
FRONTEND_URL=http://localhost:5500

# Solo si PAGOS_PROVEEDOR=wompi
WOMPI_AMBIENTE=sandbox
WOMPI_LLAVE_PUBLICA=
WOMPI_LLAVE_PRIVADA=
WOMPI_SECRETO_INTEGRIDAD=
WOMPI_SECRETO_EVENTOS=
