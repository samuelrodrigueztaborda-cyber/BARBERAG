# ── Base de datos: Supabase (PostgreSQL) ──
# Dashboard de Supabase > Project Settings > Database > Connection string > URI
# Copia la URI y reemplaza [YOUR-PASSWORD] por la contraseña de tu proyecto.
# Usa el puerto 6543 (Transaction Pooler): es el recomendado para apps como esta.
DATABASE_URL=postgresql://postgres.itgahgjyypdoyuwxdrqw:BarberAG2026SCS%2B@aws-0-us-west-2.pooler.supabase.com:6543/postgres

Alternativa: Postgres local (si NO defines DATABASE_URL se usan estas)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=BarberAG2026SCS+
DB_NAME=barberia_db
DB_PORT=5432

PORT=3000

# Cambia esto por una cadena larga y aleatoria en producción
JWT_SECRET=barberia_software_2026_las_bestias

# ── Pagos ──
